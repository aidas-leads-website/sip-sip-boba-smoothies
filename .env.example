# Copy to .env.local for local dev, and set the same key in your Vercel
# project (Settings → Environment Variables) for production.

# Your public site URL (no trailing slash). Drives canonical links, the
# sitemap, robots.txt, and Open Graph/Twitter image URLs.
# Example: https://sipsipboba.com  (or your *.vercel.app URL before a custom domain)
NEXT_PUBLIC_SITE_URL=https://sipsipboba.com
